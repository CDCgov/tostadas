nextflow_workflow {

    name "Test Workflow RUN_VADR"
    script "subworkflows/local/vadr.nf"
    workflow "RUN_VADR"

    test("Should run without failures") {

        when {
            params {
                vadr_models_dir  = "${projectDir}/vadr_files/rsv-models/"
                outdir           = "${outputDir}"
                virus_subtype    = "rsv"
                vadr_opts        = "-r --xnocomp"
                prefix           = "MZ568967"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ batch_id: "batch_1", batch_tsv: file("${projectDir}/tests/modules/local/prep_submission/batch_1.tsv"), sample_id: "MZ568967" ],
                    file("${projectDir}/assets/sample_fastas/rsv/MZ568967.fasta")
                ])
                """
            }
        }

        then {
            assert workflow.success
        }
    }
}
