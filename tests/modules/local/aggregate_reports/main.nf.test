nextflow_process {

    name "Test Process AGGREGATE_REPORTS"
    script "modules/local/aggregate_reports/main.nf"
    process "AGGREGATE_REPORTS"

    test("Should aggregate one or more batch CSVs into a single report") {

        when {
            params {

            }

            process {
                """
                input[0] = [
                    file("${projectDir}/tests/modules/local/aggregate_reports/batch_1.csv")
                ]
                input[1] = file("${projectDir}/tests/modules/local/aggregate_reports/metadata.tsv")
                """
            }
        }

        then {
            assert process.success
            assert file("${process.out.submission_report[0]}").exists()
            def lines = file("${process.out.submission_report[0]}").readLines()
            assert lines.size() == 2
            assert lines[1].startsWith('batch_1,SUB993900,RSV_USA_DRR152972,POX,processed-error,SUB993900,processed-error,')
            assert lines[1].contains(',SUB994146,processed-error,')
        }
    }
}
