nextflow_process {

    name "Test Process VADR_ANNOTATION"
    script "modules/local/vadr_annotation/main.nf"
    process "VADR_ANNOTATION"

    test("Should run without failures") {

        when {
            params {
                virus_subtype = "rsv"
                vadr_opts = "-r --xnocomp"
            }
            process {
                """
                input[0] =  [ [ batch_id: "batch_1",  batch_tsv: file("${projectDir}/tests/modules/local/prep_submission/batch_1.tsv"), sample_id: "MZ568967" ],
                               file("${projectDir}/assets/sample_fastas/rsv/MZ568967.fasta")
                            ]
                input[1] = file("${projectDir}/vadr_files/rsv-models/")
                """
            }
        }

        then {
            assert process.success
        }

    }

}
