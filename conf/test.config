/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                                    TEST PARAMS SETTINGS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

profiles {
    test {
        params {
            prod_submission         = false
            dry_run                 = true
            submission_wait_time    = 2
            poll_initial_interval   = 2
            poll_max_interval       = 5
            poll_timeout            = 10
            batch_size              = 1
            send_submission_email   = false
            overwrite_output        = true
            outdir                  = "results"
        }
    }
}
