# tostadas environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.

# ── LLM features ─────────────────────────────────────────────────────────────
# Required only when running with --use_llm true
# Alternatively, set via Nextflow Secrets: nextflow secrets set OPENAI_API_KEY <key>
OPENAI_API_KEY=

# ── NCBI credentials (alternative to submission_config.yaml) ─────────────────
# These override empty values in submission_config.yaml.
# Alternatively, set via Nextflow Secrets:
#   nextflow secrets set NCBI_USERNAME <user>
#   nextflow secrets set NCBI_PASSWORD <pass>
NCBI_USERNAME=
NCBI_PASSWORD=
